# StudyMate AI Backend Environment Variables
# Copy this file to .env and configure values before starting the backend.

# Gemini API Key (Required for AI generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Active Gemini Model (must be a valid, unretired model in Google Gen AI)
GEMINI_MODEL=gemini-3.8-flash

# Frontend URL for CORS (no wildcards in production)
FRONTEND_URL=http://localhost:5173

# Application Environment (development | production | test)
ENVIRONMENT=development

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# Rate Limiting (Slowapi format: e.g., 20/minute, 100/day)
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_AI_ENDPOINTS=15/minute

